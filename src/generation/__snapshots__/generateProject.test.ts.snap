"# frozen_string_literal: true

# Generated from the "hecho-a-mano" domain pack. Do not edit by hand.
require_relative "events"
require_relative "result"
require_relative "value_objects"

OrderError = Struct.new(:code, :command, :status, keyword_init: true)
OrderOutcome = Struct.new(:order, :events, keyword_init: true)

OrderLine = Struct.new(:listing_id, :quantity, :unit_price, keyword_init: true) do
  def subtotal
    Money.trusted(unit_price * quantity)
  end
end

class Order
  STATUSES = [:draft, :placed, :paid, :shipped, :delivered, :cancelled].freeze

  State = Struct.new(:status, :order_id, :buyer_id, :lines, :shipping_address, :tracking_number, :cancellation_reason, keyword_init: true)
  private_constant :State

  def self.start(order_id:, buyer_id:)
    new(
      State.new(
        status: :draft,
        order_id: order_id,
        buyer_id: buyer_id,
        lines: [],
        shipping_address: nil,
        tracking_number: nil,
        cancellation_reason: nil,
      )
    )
  end

  def initialize(state)
    @state = state
  end

  def status = @state.status

  def order_id = @state.order_id

  def buyer_id = @state.buyer_id

  def lines = @state.lines

  def shipping_address = @state.shipping_address

  def tracking_number = @state.tracking_number

  def cancellation_reason = @state.cancellation_reason

  def total
    Money.trusted(self.lines.sum { |item| item.subtotal })
  end

  def add_order_line(listing_id:, quantity:, unit_price:)
    return reject_invalid_state("AddOrderLine") unless status == :draft
    transition(
      { status: :draft, lines: [*self.lines, OrderLine.new(listing_id: listing_id, quantity: quantity, unit_price: unit_price)] },
      lambda do |upcoming|
        [
          OrderLineAdded.new(order_id: upcoming.order_id, listing_id: listing_id, quantity: quantity),
        ]
      end
    )
  end

  def set_shipping_address(address:)
    return reject_invalid_state("SetShippingAddress") unless status == :draft
    transition(
      { status: :draft, shipping_address: address },
      lambda do |upcoming|
        [
          ShippingAddressSet.new(order_id: upcoming.order_id, address: address),
        ]
      end
    )
  end

  def place_order
    return reject_invalid_state("PlaceOrder") unless status == :draft
    return reject(:order_must_have_lines) if self.lines.empty?
    return reject(:shipping_address_required) if self.shipping_address.nil?
    transition(
      { status: :placed },
      lambda do |upcoming|
        [
          OrderPlaced.new(order_id: upcoming.order_id, total: upcoming.total),
        ]
      end
    )
  end

  def confirm_payment(amount:)
    return reject_invalid_state("ConfirmPayment") unless status == :placed
    return reject(:payment_must_match_total) if amount != self.total
    transition(
      { status: :paid },
      lambda do |upcoming|
        [
          PaymentConfirmed.new(order_id: upcoming.order_id, amount: amount),
        ]
      end
    )
  end

  def mark_order_shipped(tracking_number:)
    return reject_invalid_state("MarkOrderShipped") unless status == :paid
    transition(
      { status: :shipped, tracking_number: tracking_number },
      lambda do |upcoming|
        [
          OrderShipped.new(order_id: upcoming.order_id, tracking_number: tracking_number),
        ]
      end
    )
  end

  def mark_order_delivered
    return reject_invalid_state("MarkOrderDelivered") unless status == :shipped
    transition(
      { status: :delivered },
      lambda do |upcoming|
        [
          OrderDelivered.new(order_id: upcoming.order_id),
        ]
      end
    )
  end

  def cancel_order(reason:)
    return reject_invalid_state("CancelOrder") unless [:draft, :placed, :paid].include?(status)
    transition(
      { status: :cancelled, cancellation_reason: reason },
      lambda do |upcoming|
        [
          OrderCancelled.new(order_id: upcoming.order_id, reason: reason),
        ]
      end
    )
  end

  private

  def transition(changes, emit)
    upcoming = self.class.new(State.new(**@state.to_h, **changes))
    return reject(:order_lines_within_limit) if upcoming.lines.length > 5
    Result.ok(OrderOutcome.new(order: upcoming, events: emit.call(upcoming)))
  end

  def reject(code) = Result.err(OrderError.new(code: code))

  def reject_invalid_state(command)
    Result.err(OrderError.new(code: :invalid_state_for_command, command: command, status: status))
  end
end
"
`;

