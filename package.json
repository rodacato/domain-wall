{
  "name": "domain-wall",
  "version": "0.0.0",
  "private": true,
  "description": "Muro: an interactive Domain-Driven Design course taught on an animated Event Storming wall.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:architecture": "depcruise src scripts --config .dependency-cruiser.cjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:architecture && pnpm test && pnpm validate:packs && pnpm validate:course && pnpm check:translations",
    "validate:packs": "tsx scripts/validate-packs.ts",
    "check:translations": "tsx scripts/check-translations.ts",
    "validate:course": "tsx scripts/validate-course.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "idb": "^8.0.4",
    "motion": "^13.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.4.1"
}
