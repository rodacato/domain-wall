        {
          "codeName": "CertificateRequiresPassingScore",
          "label": {
            "es-MX": "La constancia exige calificación aprobatoria",
            "en": "A certificate requires a passing score"
          },
          "description": {
            "es-MX": "Solo se solicita una constancia con una calificación final de 70 o más.",
            "en": "A certificate is only requested with a final score of 70 or more."
          },
          "predicate": {
            "kind": "compare",
            "left": {
              "op": "arg",
              "name": "finalScore"
            },
            "operator": ">=",
            "right": {
              "op": "literal",
              "value": 70
            }
          },
          "message": {
            "es-MX": "La calificación final debe ser de al menos 70.",
            "en": "The final score must be at least 70."
          },
          "violation": {
            "given": [],
            "when": {
              "command": "RequestCertificate",
              "args": {
                "finalScore": 50
              }
            }
          }
        },
        {
          "codeName": "HonorsRequireHighScore",
          "label": {
            "es-MX": "La mención honorífica exige 90 o más",
            "en": "Honors require a score of 90 or more"
          },
          "description": {
            "es-MX": "Una constancia con honores solo se pide con una calificación final de 90 o más.",
            "en": "A certificate with honors is only requested with a final score of 90 or more."
          },
          "predicate": {
            "kind": "any",
            "of": [
              {
                "kind": "compare",
                "left": {
                  "op": "arg",
                  "name": "distinction"
                },
                "operator": "==",
                "right": {
                  "op": "literal",
                  "value": "Standard"
                }
              },
              {
                "kind": "compare",
                "left": {
                  "op": "arg",
                  "name": "finalScore"
                },
                "operator": ">=",
                "right": {
                  "op": "literal",
                  "value": 90
                }
              }
            ]
          },
          "message": {
            "es-MX": "La mención honorífica requiere una calificación de 90 o más.",
            "en": "Honors require a score of 90 or more."
          },
          "violation": {
            "given": [],
            "when": {
              "command": "RequestCertificate",
              "args": {
                "finalScore": 75,
                "distinction": "Honors"
              }
            }
          }
        }
