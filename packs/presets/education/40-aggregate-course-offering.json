{
  "aggregates": [
    {
      "codeName": "CourseOffering",
      "label": {
        "es-MX": "Oferta de curso",
        "en": "Course offering"
      },
      "description": {
        "es-MX": "El curso tal como se vende: título, lecciones, duración total y precio, desde el borrador hasta su retiro.",
        "en": "The course as it is sold: title, lessons, total duration and price, from draft to retirement."
      },
      "context": "Catalog",
      "identity": "courseId",
      "fields": [
        {
          "codeName": "courseId",
          "label": {
            "es-MX": "Curso",
            "en": "Course"
          },
          "type": {
            "kind": "valueObject",
            "ref": "CourseId"
          }
        },
        {
          "codeName": "title",
          "label": {
            "es-MX": "Título",
            "en": "Title"
          },
          "type": {
            "kind": "valueObject",
            "ref": "CourseTitle"
          }
        },
        {
          "codeName": "lessons",
          "label": {
            "es-MX": "Lecciones",
            "en": "Lessons"
          },
          "type": {
            "kind": "list",
            "of": {
              "kind": "entity",
              "ref": "Lesson"
            }
          }
        },
        {
          "codeName": "price",
          "label": {
            "es-MX": "Precio",
            "en": "Price"
          },
          "type": {
            "kind": "optional",
            "of": {
              "kind": "valueObject",
              "ref": "Money"
            }
          }
        }
      ],
      "derived": [
        {
          "codeName": "totalMinutes",
          "label": {
            "es-MX": "Duración total en minutos",
            "en": "Total duration in minutes"
          },
          "type": {
            "kind": "valueObject",
            "ref": "DurationMinutes"
          },
          "expression": {
            "op": "sumOf",
            "collection": {
              "op": "field",
              "name": "lessons"
            },
            "term": {
              "op": "field",
              "name": "durationMinutes"
            }
          }
        }
      ],
      "entities": [
        {
          "codeName": "Lesson",
          "label": {
            "es-MX": "Lección",
            "en": "Lesson"
          },
          "description": {
            "es-MX": "Una lección del curso, con su título y su duración.",
            "en": "A lesson of the course, with its title and duration."
          },
          "identity": "lessonId",
          "fields": [
            {
              "codeName": "lessonId",
              "label": {
                "es-MX": "Lección",
                "en": "Lesson"
              },
              "type": {
                "kind": "valueObject",
                "ref": "LessonId"
              }
            },
            {
              "codeName": "title",
              "label": {
                "es-MX": "Título",
                "en": "Title"
              },
              "type": {
                "kind": "valueObject",
                "ref": "LessonTitle"
              }
            },
            {
              "codeName": "durationMinutes",
              "label": {
                "es-MX": "Duración en minutos",
                "en": "Duration in minutes"
              },
              "type": {
                "kind": "valueObject",
                "ref": "DurationMinutes"
              }
            }
          ],
          "derived": []
        }
      ],
      "states": [
        {
          "codeName": "Draft",
          "label": {
            "es-MX": "Borrador",
            "en": "Draft"
          },
          "description": {
            "es-MX": "El instructor todavía arma el curso.",
            "en": "The instructor is still building the course."
          },
          "terminal": false,
          "data": []
        },
        {
          "codeName": "Published",
          "label": {
            "es-MX": "Publicado",
            "en": "Published"
          },
          "description": {
            "es-MX": "El curso se vende en el catálogo.",
            "en": "The course is on sale in the catalog."
          },
          "terminal": false,
          "data": [
            {
              "codeName": "publishedOn",
              "label": {
                "es-MX": "Fecha de publicación",
                "en": "Publication date"
              },
              "type": {
                "kind": "primitive",
                "name": "date"
              }
            }
          ]
        },
        {
          "codeName": "Retired",
          "label": {
            "es-MX": "Retirado",
            "en": "Retired"
          },
          "description": {
            "es-MX": "El curso salió del catálogo para siempre.",
            "en": "The course left the catalog for good."
          },
          "terminal": true,
          "data": [
            {
              "codeName": "retirementReason",
              "label": {
                "es-MX": "Motivo del retiro",
                "en": "Retirement reason"
              },
              "type": {
                "kind": "valueObject",
                "ref": "ReasonText"
              }
            }
          ]
        }
      ],
      "initialState": "Draft",
      "rules": [
        {
          "codeName": "CourseNeedsLessons",
          "label": {
            "es-MX": "El curso necesita al menos una lección",
            "en": "The course needs at least one lesson"
          },
          "description": {
            "es-MX": "No se puede publicar un curso vacío.",
            "en": "An empty course cannot be published."
          },
          "predicate": {
            "kind": "notEmpty",
            "value": {
              "op": "field",
              "name": "lessons"
            }
          },
          "message": {
            "es-MX": "Un curso necesita al menos una lección para publicarse.",
            "en": "A course needs at least one lesson to be published."
          },
          "violation": {
            "given": [],
            "when": {
              "command": "PublishCourse",
              "args": {}
            }
          }
        },
        {
          "codeName": "CourseNeedsPrice",
          "label": {
            "es-MX": "El curso necesita un precio",
            "en": "The course needs a price"
          },
          "description": {
            "es-MX": "No se publica un curso sin precio definido.",
            "en": "A course without a defined price is not published."
          },
          "predicate": {
            "kind": "present",
            "value": {
              "op": "field",
              "name": "price"
            }
          },
          "message": {
            "es-MX": "Define el precio del curso antes de publicarlo.",
            "en": "Set the course price before publishing it."
          },
          "violation": {
            "given": [
              {
                "command": "AddLesson",
                "args": {}
              }
            ],
            "when": {
              "command": "PublishCourse",
              "args": {}
            }
          }
        },
        {
          "codeName": "CourseDurationWithinLimit",
          "label": {
            "es-MX": "El curso tiene una duración máxima",
            "en": "The course has a maximum duration"
          },
          "description": {
            "es-MX": "Un curso admite hasta 600 minutos de contenido; si es más largo se divide en dos cursos.",
            "en": "A course holds up to 600 minutes of content; if it is longer it is split into two courses."
          },
          "predicate": {
            "kind": "compare",
            "left": {
              "op": "field",
              "name": "totalMinutes"
            },
            "operator": "<=",
            "right": {
              "op": "literal",
              "value": 600
            }
          },
          "message": {
            "es-MX": "Un curso no puede pasar de 600 minutos en total.",
            "en": "A course cannot exceed 600 minutes in total."
          },
          "violation": {
            "given": [
              {
                "command": "AddLesson",
                "args": {
                  "durationMinutes": 300
                }
              },
              {
                "command": "AddLesson",
                "args": {
                  "durationMinutes": 300
                }
              }
            ],
            "when": {
              "command": "AddLesson",
              "args": {
                "durationMinutes": 300
              }
            }
          }
        }
      ],
      "invariants": ["CourseDurationWithinLimit"],
      "transitions": [
        {
          "command": "AddLesson",
          "from": ["Draft"],
          "to": "Draft",
          "guards": [],
          "effects": [
            {
              "op": "append",
              "field": "lessons",
              "value": {
                "op": "construct",
                "type": "Lesson",
                "fields": [
                  {
                    "name": "lessonId",
                    "value": {
                      "op": "arg",
                      "name": "lessonId"
                    }
                  },
                  {
                    "name": "title",
                    "value": {
                      "op": "arg",
                      "name": "lessonTitle"
                    }
                  },
                  {
                    "name": "durationMinutes",
                    "value": {
                      "op": "arg",
                      "name": "durationMinutes"
                    }
                  }
                ]
              }
            }
          ],
          "emits": ["LessonAdded"]
        },
        {
          "command": "SetCoursePrice",
          "from": ["Draft"],
          "to": "Draft",
          "guards": [],
          "effects": [
            {
              "op": "set",
              "field": "price",
              "value": {
                "op": "arg",
                "name": "price"
              }
            }
          ],
          "emits": ["CoursePriced"]
        },
        {
          "command": "PublishCourse",
          "from": ["Draft"],
          "to": "Published",
          "guards": ["CourseNeedsLessons", "CourseNeedsPrice"],
          "effects": [
            {
              "op": "set",
              "field": "publishedOn",
              "value": {
                "op": "arg",
                "name": "publishedOn"
              }
            }
          ],
          "emits": ["CoursePublished"]
        },
        {
          "command": "UnpublishCourse",
          "from": ["Published"],
          "to": "Draft",
          "guards": [],
          "effects": [],
          "emits": ["CourseUnpublished"]
        },
        {
          "command": "RetireCourse",
          "from": ["Draft", "Published"],
          "to": "Retired",
          "guards": [],
          "effects": [
            {
              "op": "set",
              "field": "retirementReason",
              "value": {
                "op": "arg",
                "name": "reason"
              }
            }
          ],
          "emits": ["CourseRetired"]
        }
      ],
      "walkthrough": [
        {
          "command": "AddLesson",
          "args": {
            "lessonId": "les_7h3j9d5x",
            "durationMinutes": 45
          }
        },
        {
          "command": "AddLesson",
          "args": {
            "lessonId": "les_1b5n8c2v",
            "lessonTitle": "Gráficas que cuentan una historia",
            "durationMinutes": 90
          }
        },
        {
          "command": "SetCoursePrice",
          "args": {
            "price": 90000
          }
        },
        {
          "command": "PublishCourse",
          "args": {
            "publishedOn": "2026-10-01"
          }
        },
        {
          "command": "UnpublishCourse",
          "args": {}
        },
        {
          "command": "RetireCourse",
          "args": {
            "reason": "Contenido reemplazado por una edición nueva"
          }
        }
      ]
    }
  ]
}
