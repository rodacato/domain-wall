{
  "aggregates": [
    {
      "codeName": "Enrollment",
      "label": {
        "es-MX": "Inscripción",
        "en": "Enrollment"
      },
      "description": {
        "es-MX": "El lugar que una persona compró en una cohorte de un curso: su pago, su acceso y su avance hasta graduarse.",
        "en": "The seat a person bought in a cohort of a course: its payment, access and progress until graduation."
      },
      "context": "Enrolling",
      "identity": "enrollmentId",
      "fields": [
        {
          "codeName": "enrollmentId",
          "label": {
            "es-MX": "Inscripción",
            "en": "Enrollment"
          },
          "type": {
            "kind": "valueObject",
            "ref": "EnrollmentId"
          }
        },
        {
          "codeName": "studentId",
          "label": {
            "es-MX": "Estudiante",
            "en": "Student"
          },
          "type": {
            "kind": "valueObject",
            "ref": "StudentId"
          }
        },
        {
          "codeName": "courseId",
          "label": {
            "es-MX": "Curso",
            "en": "Course"
          },
          "type": {
            "kind": "valueObject",
            "ref": "CourseId"
          }
        },
        {
          "codeName": "cohortCode",
          "label": {
            "es-MX": "Cohorte",
            "en": "Cohort"
          },
          "type": {
            "kind": "valueObject",
            "ref": "CohortCode"
          }
        },
        {
          "codeName": "price",
          "label": {
            "es-MX": "Precio",
            "en": "Price"
          },
          "type": {
            "kind": "valueObject",
            "ref": "Money"
          }
        },
        {
          "codeName": "totalLessons",
          "label": {
            "es-MX": "Lecciones del curso",
            "en": "Course lessons"
          },
          "type": {
            "kind": "valueObject",
            "ref": "LessonCount"
          }
        },
        {
          "codeName": "lessonsCompleted",
          "label": {
            "es-MX": "Lecciones completadas",
            "en": "Completed lessons"
          },
          "type": {
            "kind": "valueObject",
            "ref": "LessonCount"
          }
        }
      ],
      "derived": [
        {
          "codeName": "lessonsRemaining",
          "label": {
            "es-MX": "Lecciones pendientes",
            "en": "Remaining lessons"
          },
          "type": {
            "kind": "valueObject",
            "ref": "LessonCount"
          },
          "expression": {
            "op": "arithmetic",
            "operator": "subtract",
            "left": {
              "op": "field",
              "name": "totalLessons"
            },
            "right": {
              "op": "field",
              "name": "lessonsCompleted"
            }
          }
        }
      ],
      "entities": [],
      "states": [
        {
          "codeName": "Draft",
          "label": {
            "es-MX": "Borrador",
            "en": "Draft"
          },
          "description": {
            "es-MX": "La persona aún no pide su lugar.",
            "en": "The person has not asked for a seat yet."
          },
          "terminal": false,
          "data": []
        },
        {
          "codeName": "PendingPayment",
          "label": {
            "es-MX": "Pago pendiente",
            "en": "Pending payment"
          },
          "description": {
            "es-MX": "El lugar está apartado y espera el pago.",
            "en": "The seat is held and awaits payment."
          },
          "terminal": false,
          "data": []
        },
        {
          "codeName": "Active",
          "label": {
            "es-MX": "Activa",
            "en": "Active"
          },
          "description": {
            "es-MX": "El estudiante ya pagó y está cursando.",
            "en": "The student has paid and is studying."
          },
          "terminal": false,
          "data": [
            {
              "codeName": "accessUntil",
              "label": {
                "es-MX": "Acceso hasta",
                "en": "Access until"
              },
              "type": {
                "kind": "primitive",
                "name": "date"
              }
            }
          ]
        },
        {
          "codeName": "CourseCompleted",
          "label": {
            "es-MX": "Curso completado",
            "en": "Course completed"
          },
          "description": {
            "es-MX": "Terminó todas las lecciones y le falta aprobar el examen.",
            "en": "Finished every lesson and still has to pass the exam."
          },
          "terminal": false,
          "data": []
        },
        {
          "codeName": "Graduated",
          "label": {
            "es-MX": "Graduada",
            "en": "Graduated"
          },
          "description": {
            "es-MX": "El estudiante aprobó y la inscripción se cerró con éxito.",
            "en": "The student passed and the enrollment closed successfully."
          },
          "terminal": true,
          "data": []
        },
        {
          "codeName": "Refunded",
          "label": {
            "es-MX": "Reembolsada",
            "en": "Refunded"
          },
          "description": {
            "es-MX": "Se devolvió el pago antes de empezar.",
            "en": "The payment was returned before starting."
          },
          "terminal": true,
          "data": [
            {
              "codeName": "refundReason",
              "label": {
                "es-MX": "Motivo del reembolso",
                "en": "Refund reason"
              },
              "type": {
                "kind": "valueObject",
                "ref": "ReasonText"
              }
            }
          ]
        },
        {
          "codeName": "Cancelled",
          "label": {
            "es-MX": "Cancelada",
            "en": "Cancelled"
          },
          "description": {
            "es-MX": "Se soltó el lugar sin llegar a pagarlo.",
            "en": "The seat was released without being paid for."
          },
          "terminal": true,
          "data": [
            {
              "codeName": "cancellationReason",
              "label": {
                "es-MX": "Motivo de cancelación",
                "en": "Cancellation reason"
              },
              "type": {
                "kind": "valueObject",
                "ref": "ReasonText"
              }
            }
          ]
        }
      ],
      "initialState": "Draft",
      "rules": [
        {
          "codeName": "EnrollmentNeedsLessons",
          "label": {
            "es-MX": "El curso debe tener lecciones",
            "en": "The course must have lessons"
          },
          "description": {
            "es-MX": "No se vende un lugar en un curso sin lecciones.",
            "en": "A seat in a course without lessons is not sold."
          },
          "predicate": {
            "kind": "compare",
            "left": {
              "op": "arg",
              "name": "totalLessons"
            },
            "operator": ">",
            "right": {
              "op": "literal",
              "value": 0
            }
          },
          "message": {
            "es-MX": "No te puedes inscribir a un curso sin lecciones.",
            "en": "You cannot enroll in a course without lessons."
          },
          "violation": {
            "given": [],
            "when": {
              "command": "RequestEnrollment",
              "args": {
                "totalLessons": 0
              }
            }
          }
        },
        {
          "codeName": "PaymentMustMatchPrice",
          "label": {
            "es-MX": "El pago debe ser igual al precio",
            "en": "The payment must equal the price"
          },
          "description": {
            "es-MX": "Solo se acepta el pago exacto del precio acordado.",
            "en": "Only the exact payment of the agreed price is accepted."
          },
          "predicate": {
            "kind": "compare",
            "left": {
              "op": "arg",
              "name": "amount"
            },
            "operator": "==",
            "right": {
              "op": "field",
              "name": "price"
            }
          },
          "message": {
            "es-MX": "El pago debe ser igual al precio de la inscripción.",
            "en": "The payment must equal the enrollment price."
          },
          "violation": {
            "given": [
              {
                "command": "RequestEnrollment",
                "args": {
                  "price": 90000,
                  "totalLessons": 2
                }
              }
            ],
            "when": {
              "command": "ConfirmEnrollmentPayment",
              "args": {
                "amount": 1
              }
            }
          }
        },
        {
          "codeName": "RefundOnlyBeforeFirstLesson",
          "label": {
            "es-MX": "El reembolso es solo antes de la primera lección",
            "en": "Refunds only before the first lesson"
          },
          "description": {
            "es-MX": "Una vez que el estudiante empezó a cursar, el pago ya no se devuelve.",
            "en": "Once the student has started, the payment is no longer returned."
          },
          "predicate": {
            "kind": "compare",
            "left": {
              "op": "field",
              "name": "lessonsCompleted"
            },
            "operator": "==",
            "right": {
              "op": "literal",
              "value": 0
            }
          },
          "message": {
            "es-MX": "Ya no se puede reembolsar: el estudiante completó al menos una lección.",
            "en": "A refund is no longer possible: the student completed at least one lesson."
          },
          "violation": {
            "given": [
              {
                "command": "RequestEnrollment",
                "args": {
                  "price": 90000,
                  "totalLessons": 2
                }
              },
              {
                "command": "ConfirmEnrollmentPayment",
                "args": {
                  "amount": 90000,
                  "accessUntil": "2027-10-01"
                }
              },
              {
                "command": "CompleteLesson",
                "args": {}
              }
            ],
            "when": {
              "command": "RefundEnrollment",
              "args": {}
            }
          }
        },
        {
          "codeName": "AllLessonsCompleted",
          "label": {
            "es-MX": "Deben completarse todas las lecciones",
            "en": "Every lesson must be completed"
          },
          "description": {
            "es-MX": "El curso solo se termina cuando se completó cada lección.",
            "en": "The course is only finished once every lesson is completed."
          },
          "predicate": {
            "kind": "compare",
            "left": {
              "op": "field",
              "name": "lessonsCompleted"
            },
            "operator": "==",
            "right": {
              "op": "field",
              "name": "totalLessons"
            }
          },
          "message": {
            "es-MX": "Aún faltan lecciones por completar.",
            "en": "There are still lessons left to complete."
          },
          "violation": {
            "given": [
              {
                "command": "RequestEnrollment",
                "args": {
                  "price": 90000,
                  "totalLessons": 2
                }
              },
              {
                "command": "ConfirmEnrollmentPayment",
                "args": {
                  "amount": 90000,
                  "accessUntil": "2027-10-01"
                }
              },
              {
                "command": "CompleteLesson",
                "args": {}
              }
            ],
            "when": {
              "command": "FinishCourse",
              "args": {}
            }
          }
        },
        {
          "codeName": "LessonsWithinCourse",
          "label": {
            "es-MX": "No se completan más lecciones de las que hay",
            "en": "Cannot complete more lessons than exist"
          },
          "description": {
            "es-MX": "El avance nunca supera el número de lecciones del curso.",
            "en": "Progress never exceeds the number of lessons in the course."
          },
          "predicate": {
            "kind": "compare",
            "left": {
              "op": "field",
              "name": "lessonsCompleted"
            },
            "operator": "<=",
            "right": {
              "op": "field",
              "name": "totalLessons"
            }
          },
          "message": {
            "es-MX": "El curso no tiene más lecciones que completar.",
            "en": "The course has no more lessons to complete."
          },
          "violation": {
            "given": [
              {
                "command": "RequestEnrollment",
                "args": {
                  "price": 90000,
                  "totalLessons": 1
                }
              },
              {
                "command": "ConfirmEnrollmentPayment",
                "args": {
                  "amount": 90000,
                  "accessUntil": "2027-10-01"
                }
              },
              {
                "command": "CompleteLesson",
                "args": {}
              }
            ],
            "when": {
              "command": "CompleteLesson",
              "args": {}
            }
          }
        }
      ],
      "invariants": ["LessonsWithinCourse"],
      "transitions": [
        {
          "command": "RequestEnrollment",
          "from": ["Draft"],
          "to": "PendingPayment",
          "guards": ["EnrollmentNeedsLessons"],
          "effects": [
            {
              "op": "set",
              "field": "studentId",
              "value": {
                "op": "arg",
                "name": "studentId"
              }
            },
            {
              "op": "set",
              "field": "courseId",
              "value": {
                "op": "arg",
                "name": "courseId"
              }
            },
            {
              "op": "set",
              "field": "cohortCode",
              "value": {
                "op": "arg",
                "name": "cohortCode"
              }
            },
            {
              "op": "set",
              "field": "price",
              "value": {
                "op": "arg",
                "name": "price"
              }
            },
            {
              "op": "set",
              "field": "totalLessons",
              "value": {
                "op": "arg",
                "name": "totalLessons"
              }
            }
          ],
          "emits": ["EnrollmentRequested"]
        },
        {
          "command": "ConfirmEnrollmentPayment",
          "from": ["PendingPayment"],
          "to": "Active",
          "guards": ["PaymentMustMatchPrice"],
          "effects": [
            {
              "op": "set",
              "field": "accessUntil",
              "value": {
                "op": "arg",
                "name": "accessUntil"
              }
            }
          ],
          "emits": ["EnrollmentPaid"]
        },
        {
          "command": "CompleteLesson",
          "from": ["Active"],
          "to": "Active",
          "guards": [],
          "effects": [
            {
              "op": "set",
              "field": "lessonsCompleted",
              "value": {
                "op": "arithmetic",
                "operator": "add",
                "left": {
                  "op": "field",
                  "name": "lessonsCompleted"
                },
                "right": {
                  "op": "literal",
                  "value": 1
                }
              }
            }
          ],
          "emits": ["LessonCompleted"]
        },
        {
          "command": "FinishCourse",
          "from": ["Active"],
          "to": "CourseCompleted",
          "guards": ["AllLessonsCompleted"],
          "effects": [],
          "emits": ["CourseFinished"]
        },
        {
          "command": "GraduateEnrollment",
          "from": ["CourseCompleted"],
          "to": "Graduated",
          "guards": [],
          "effects": [],
          "emits": ["EnrollmentGraduated"]
        },
        {
          "command": "RefundEnrollment",
          "from": ["Active"],
          "to": "Refunded",
          "guards": ["RefundOnlyBeforeFirstLesson"],
          "effects": [
            {
              "op": "set",
              "field": "refundReason",
              "value": {
                "op": "arg",
                "name": "reason"
              }
            }
          ],
          "emits": ["EnrollmentRefunded"]
        },
        {
          "command": "CancelEnrollment",
          "from": ["PendingPayment"],
          "to": "Cancelled",
          "guards": [],
          "effects": [
            {
              "op": "set",
              "field": "cancellationReason",
              "value": {
                "op": "arg",
                "name": "reason"
              }
            }
          ],
          "emits": ["EnrollmentCancelled"]
        }
      ],
      "walkthrough": [
        {
          "command": "RequestEnrollment",
          "args": {
            "studentId": "stu_2m6q8v1c",
            "courseId": "crs_4k8w2n6p",
            "cohortCode": "2026-Q4",
            "price": 90000,
            "totalLessons": 2
          }
        },
        {
          "command": "ConfirmEnrollmentPayment",
          "args": {
            "amount": 90000,
            "accessUntil": "2027-10-01"
          }
        },
        {
          "command": "CompleteLesson",
          "args": {
            "lessonId": "les_7h3j9d5x"
          }
        },
        {
          "command": "CompleteLesson",
          "args": {
            "lessonId": "les_1b5n8c2v"
          }
        },
        {
          "command": "FinishCourse",
          "args": {}
        },
        {
          "command": "GraduateEnrollment",
          "args": {}
        }
      ]
    }
  ]
}
