        {
          "command": "ReturnParcelToMerchant",
          "from": ["Received", "Sorted"],
          "to": "Returned",
          "guards": [],
          "effects": [],
          "emits": ["ParcelReturnedToMerchant"]
        }
      ],
      "walkthrough": [
        {
          "command": "ReceiveParcel",
          "args": {
            "trackingCode": "RR123456789MX",
