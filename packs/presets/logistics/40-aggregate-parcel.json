      ],
      "initialState": "Expected",
      "rules": [
        {
          "codeName": "ParcelWithinWeightLimit",
          "label": {
            "es-MX": "El paquete respeta el peso máximo",
            "en": "The parcel respects the maximum weight"
          },
          "description": {
            "es-MX": "Las camionetas de reparto no aceptan paquetes de más de 25 kg.",
            "en": "Delivery vans do not take parcels over 25 kg."
          },
          "predicate": {
            "kind": "compare",
            "left": {
              "op": "arg",
              "name": "weightGrams"
            },
            "operator": "<=",
            "right": {
              "op": "literal",
              "value": 25000
            }
          },
          "message": {
            "es-MX": "El paquete no puede pesar más de 25 kg.",
            "en": "The parcel cannot weigh more than 25 kg."
          },
          "violation": {
            "given": [],
            "when": {
              "command": "ReceiveParcel",
              "args": {
                "weightGrams": 25001
              }
            }
          }
        },
        {
          "codeName": "DestinationMustBeCovered",
          "label": {
            "es-MX": "El destino debe tener cobertura",
            "en": "The destination must be covered"
          },
          "description": {
            "es-MX": "No se clasifica un paquete cuyo destino está fuera de las zonas de reparto.",
            "en": "A parcel whose destination is outside the delivery zones is not sorted."
          },
          "predicate": {
            "kind": "compare",
            "left": {
              "op": "arg",
              "name": "destinationZone"
            },
            "operator": "!=",
            "right": {
              "op": "literal",
              "value": "OutOfCoverage"
            }
          },
          "message": {
            "es-MX": "El destino está fuera de cobertura.",
            "en": "The destination is outside coverage."
          },
          "violation": {
            "given": [
              {
                "command": "ReceiveParcel",
                "args": {
                  "trackingCode": "RR123456789MX",
                  "weightGrams": 2300
                }
              }
            ],
            "when": {
              "command": "SortParcel",
              "args": {
                "destinationZone": "OutOfCoverage"
              }
            }
          }
        }
      ],
      "invariants": [],
      "transitions": [
        {
          "command": "ReceiveParcel",
          "from": ["Expected"],
          "to": "Received",
          "guards": ["ParcelWithinWeightLimit"],
          "effects": [
            {
              "op": "set",
              "field": "trackingCode",
              "value": {
                "op": "arg",
