              "value": {
                "op": "arg",
                "name": "cashToCollect"
              }
            }
          ],
          "emits": ["DeliveryScheduled"]
        },
        {
          "command": "StartDelivery",
          "from": ["Scheduled"],
          "to": "OutForDelivery",
          "guards": [],
          "effects": [
            {
              "op": "set",
              "field": "driverId",
              "value": {
                "op": "arg",
                "name": "driverId"
              }
            }
          ],
          "emits": ["DeliveryStarted"]
        },
        {
          "command": "CompleteDelivery",
          "from": ["OutForDelivery"],
          "to": "Delivered",
          "guards": ["DeliveryNeedsProof", "CollectedCashMustMatchDue"],
          "effects": [
            {
              "op": "set",
              "field": "proof",
              "value": {
                "op": "arg",
                "name": "proof"
              }
            }
          ],
          "emits": ["DeliveryCompleted"]
        },
        {
          "command": "ReportFailedAttempt",
          "from": ["OutForDelivery"],
          "to": "AttemptFailed",
          "guards": ["FailedAttemptNeedsReason"],
          "effects": [
            {
              "op": "set",
              "field": "failureReason",
              "value": {
                "op": "arg",
                "name": "reason"
              }
            },
            {
              "op": "set",
              "field": "attemptCount",
              "value": {
                "op": "arithmetic",
                "operator": "add",
                "left": {
                  "op": "field",
                  "name": "attemptCount"
                },
                "right": {
                  "op": "literal",
                  "value": 1
                }
              }
            }
          ],
          "emits": ["DeliveryAttemptFailed"]
        },
        {
          "command": "RescheduleDelivery",
          "from": ["AttemptFailed"],
          "to": "Scheduled",
          "guards": ["DeliveryWindowMustBeOrdered", "DeliveryAttemptsWithinLimit"],
          "effects": [
            {
              "op": "set",
              "field": "deliveryDate",
              "value": {
                "op": "arg",
                "name": "deliveryDate"
              }
            },
            {
              "op": "set",
              "field": "windowStartHour",
              "value": {
                "op": "arg",
                "name": "windowStartHour"
              }
            },
            {
              "op": "set",
              "field": "windowEndHour",
              "value": {
                "op": "arg",
                "name": "windowEndHour"
              }
            }
          ],
          "emits": ["DeliveryRescheduled"]
        },
        {
          "command": "ReturnToSender",
          "from": ["AttemptFailed"],
          "to": "ReturnedToSender",
          "guards": [],
          "effects": [],
          "emits": ["DeliveryReturned"]
        },
        {
          "command": "CancelDelivery",
          "from": ["Requested", "Scheduled", "AttemptFailed"],
          "to": "Cancelled",
          "guards": [],
          "effects": [
            {
              "op": "set",
              "field": "cancellationReason",
              "value": {
                "op": "arg",
                "name": "reason"
              }
            }
          ],
          "emits": ["DeliveryCancelled"]
        }
      ],
      "walkthrough": [
