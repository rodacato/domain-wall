    {
      "kind": "scalar",
      "codeName": "TrackingCode",
      "label": {
        "es-MX": "Número de guía",
        "en": "Tracking code"
      },
      "description": {
        "es-MX": "Guía del paquete con formato postal: 2 letras, 9 dígitos y MX.",
        "en": "Parcel tracking code in postal format: 2 letters, 9 digits and MX."
      },
      "base": "string",
      "constraints": [
        {
          "kind": "pattern",
          "value": "[A-Z]{2}[0-9]{9}MX",
          "errorCode": "TrackingCodeMalformed",
          "message": {
            "es-MX": "La guía debe tener 2 letras mayúsculas, 9 dígitos y terminar en MX.",
            "en": "The tracking code must have 2 uppercase letters, 9 digits and end in MX."
          },
          "invalidExamples": ["rr123456789mx", "RR12345MX", "RR123456789US"]
        }
      ],
      "examples": {
        "valid": ["RR123456789MX"]
      }
    },
    {
      "kind": "scalar",
      "codeName": "Money",
      "label": {
        "es-MX": "Dinero",
        "en": "Money"
      },
      "description": {
        "es-MX": "Un monto en centavos de peso mexicano, nunca negativo.",
        "en": "An amount in Mexican peso cents, never negative."
      },
      "base": "integer",
      "constraints": [
        {
          "kind": "min",
          "value": 0,
          "errorCode": "MoneyCannotBeNegative",
          "message": {
            "es-MX": "El monto no puede ser negativo.",
            "en": "The amount cannot be negative."
          },
          "invalidExamples": [-1, -500]
        }
      ],
      "examples": {
        "valid": [45000, 3500]
      }
    },
    {
      "kind": "scalar",
      "codeName": "WeightGrams",
      "label": {
        "es-MX": "Peso en gramos",
        "en": "Weight in grams"
      },
      "description": {
        "es-MX": "El peso de un paquete en gramos; siempre positivo.",
        "en": "The weight of a parcel in grams; always positive."
      },
      "base": "integer",
      "constraints": [
        {
          "kind": "min",
          "value": 1,
          "errorCode": "WeightMustBePositive",
          "message": {
            "es-MX": "El peso debe ser mayor a cero.",
            "en": "The weight must be greater than zero."
          },
          "invalidExamples": [0, -10]
        }
      ],
      "examples": {
        "valid": [1500, 800]
      }
    },
    {
      "kind": "scalar",
      "codeName": "LoadGrams",
      "label": {
        "es-MX": "Carga en gramos",
        "en": "Load in grams"
      },
      "description": {
        "es-MX": "El peso total que lleva una camioneta, en gramos; puede ser cero.",
        "en": "The total weight a van carries, in grams; it can be zero."
      },
      "base": "integer",
      "constraints": [
        {
          "kind": "min",
          "value": 0,
          "errorCode": "LoadCannotBeNegative",
          "message": {
            "es-MX": "La carga no puede ser negativa.",
            "en": "The load cannot be negative."
          },
          "invalidExamples": [-1, -300]
        }
      ],
      "examples": {
        "valid": [0, 12000]
      }
    },
    {
      "kind": "scalar",
      "codeName": "AttemptCount",
      "label": {
        "es-MX": "Intentos de entrega",
        "en": "Delivery attempts"
      },
      "description": {
        "es-MX": "Cuántos intentos de entrega se han hecho: entre 0 y 3.",
        "en": "How many delivery attempts have been made: between 0 and 3."
      },
      "base": "integer",
      "constraints": [
        {
          "kind": "min",
          "value": 0,
          "errorCode": "AttemptCountCannotBeNegative",
          "message": {
            "es-MX": "Los intentos no pueden ser negativos.",
            "en": "Attempts cannot be negative."
          },
          "invalidExamples": [-1]
        },
        {
          "kind": "max",
          "value": 3,
          "errorCode": "AttemptCountTooLarge",
          "message": {
            "es-MX": "Los intentos no pueden pasar de 3.",
            "en": "Attempts cannot exceed 3."
          },
          "invalidExamples": [4, 10]
        }
      ],
      "examples": {
        "valid": [0, 1, 2]
      }
    },
    {
      "kind": "scalar",
      "codeName": "HourOfDay",
      "label": {
        "es-MX": "Hora del día",
        "en": "Hour of the day"
      },
      "description": {
        "es-MX": "Una hora completa del día, de 0 a 23.",
        "en": "A whole hour of the day, from 0 to 23."
      },
      "base": "integer",
      "constraints": [
        {
          "kind": "min",
          "value": 0,
          "errorCode": "HourBelowRange",
          "message": {
            "es-MX": "La hora no puede ser menor a 0.",
            "en": "The hour cannot be below 0."
          },
          "invalidExamples": [-1]
        },
        {
          "kind": "max",
          "value": 23,
          "errorCode": "HourAboveRange",
          "message": {
            "es-MX": "La hora no puede pasar de 23.",
            "en": "The hour cannot exceed 23."
          },
          "invalidExamples": [24, 30]
        }
      ],
      "examples": {
        "valid": [9, 13, 18]
      }
    },
    {
      "kind": "scalar",
      "codeName": "StopPosition",
      "label": {
        "es-MX": "Posición de la parada",
        "en": "Stop position"
      },
      "description": {
        "es-MX": "El lugar de una parada dentro de la ruta, desde 1.",
        "en": "The place of a stop within the route, starting at 1."
      },
      "base": "integer",
      "constraints": [
        {
          "kind": "min",
          "value": 1,
          "errorCode": "StopPositionMustBePositive",
          "message": {
            "es-MX": "La posición debe ser al menos 1.",
            "en": "The position must be at least 1."
          },
          "invalidExamples": [0, -1]
        },
        {
          "kind": "max",
          "value": 99,
          "errorCode": "StopPositionTooLarge",
          "message": {
            "es-MX": "La posición no puede pasar de 99.",
            "en": "The position cannot exceed 99."
          },
          "invalidExamples": [100]
        }
      ],
      "examples": {
        "valid": [1, 2, 3]
      }
    },
    {
      "kind": "scalar",
      "codeName": "StopCount",
      "label": {
        "es-MX": "Cantidad de paradas",
        "en": "Stop count"
      },
      "description": {
        "es-MX": "Cuántas paradas se cuentan en una ruta: entre 0 y 99.",
        "en": "How many stops are counted on a route: between 0 and 99."
