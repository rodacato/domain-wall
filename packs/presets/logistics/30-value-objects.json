{
  "valueObjects": [
    {
      "kind": "scalar",
      "codeName": "ParcelId",
      "label": {
        "es-MX": "Paquete",
        "en": "Parcel"
      },
      "description": {
        "es-MX": "Identificador de un paquete.",
        "en": "Identifier of a parcel."
      },
      "base": "string",
      "constraints": [
        {
          "kind": "pattern",
          "value": "pcl_[a-z0-9]{8}",
          "errorCode": "ParcelIdMalformed",
          "message": {
            "es-MX": "El identificador de un paquete debe empezar con pcl_ seguido de 8 caracteres.",
            "en": "The parcel identifier must start with pcl_ followed by 8 characters."
          },
          "invalidExamples": ["PCL_11111111", "pcl_12"]
        }
      ],
      "examples": {
        "valid": ["pcl_8w4y6e2l"]
      }
    },
    {
      "kind": "scalar",
      "codeName": "RouteId",
      "label": {
