      "base": "integer",
      "constraints": [
        {
          "kind": "min",
          "value": 0,
          "errorCode": "StopCountCannotBeNegative",
          "message": {
            "es-MX": "La cantidad de paradas no puede ser negativa.",
            "en": "The stop count cannot be negative."
          },
          "invalidExamples": [-1]
        },
        {
          "kind": "max",
          "value": 99,
          "errorCode": "StopCountTooLarge",
          "message": {
            "es-MX": "La cantidad de paradas no puede pasar de 99.",
            "en": "The stop count cannot exceed 99."
          },
          "invalidExamples": [100]
        }
      ],
      "examples": {
        "valid": [0, 3, 8]
      }
