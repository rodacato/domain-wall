            "en": "Setup"
          },
          "description": {
            "es-MX": "El repositorio todavía no existe.",
            "en": "The repository does not exist yet."
          },
          "terminal": false,
          "data": []
        },
        {
          "codeName": "Active",
          "label": {
            "es-MX": "Activo",
            "en": "Active"
          },
          "description": {
            "es-MX": "Se puede subir código y abrir pull requests.",
            "en": "Code can be pushed and pull requests opened."
