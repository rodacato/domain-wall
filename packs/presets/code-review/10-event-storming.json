  "policies": [
    {
      "codeName": "QueueCheckRunWhenPullRequestOpened",
      "label": {
        "es-MX": "Al abrir un PR, correr el CI",
        "en": "When a PR opens, run CI"
      },
      "description": {
        "es-MX": "Cada pull request nuevo manda su commit a la cola del CI.",
        "en": "Every new pull request sends its commit to the CI queue."
      },
      "context": "Checks",
      "when": "PullRequestOpened",
      "then": "QueueCheckRun"
    },
    {
      "codeName": "RecordChecksWhenCheckRunPassed",
      "label": {
        "es-MX": "CI en verde, avisar al PR",
        "en": "When CI passes, tell the PR"
      },
      "description": {
        "es-MX": "Cuando el CI pasa, el pull request lo anota para poder hacer merge.",
        "en": "When CI passes, the pull request records it so it can be merged."
      },
      "context": "Reviewing",
      "when": "CheckRunPassed",
      "then": "RecordChecksPassed"
    },
    {
      "codeName": "DraftReleaseWhenPullRequestMerged",
      "label": {
        "es-MX": "Tras el merge, armar el release",
        "en": "After a merge, draft the release"
      },
      "description": {
        "es-MX": "Cada merge a la rama principal alimenta el borrador del siguiente release.",
        "en": "Every merge into the main branch feeds the draft of the next release."
      },
      "context": "Releasing",
      "when": "PullRequestMerged",
      "then": "DraftRelease"
    }
  ],
