          },
          "terminal": false,
          "data": []
        },
        {
          "codeName": "Queued",
          "label": {
            "es-MX": "En cola",
            "en": "Queued"
          },
          "description": {
            "es-MX": "Espera un runner libre.",
            "en": "Waiting for a free runner."
          },
          "terminal": false,
          "data": []
        },
        {
          "codeName": "Running",
          "label": {
            "es-MX": "Corriendo",
            "en": "Running"
          },
          "description": {
            "es-MX": "El CI está probando el commit.",
            "en": "CI is testing the commit."
          },
          "terminal": false,
          "data": []
        },
        {
          "codeName": "Passed",
          "label": {
            "es-MX": "En verde",
            "en": "Passed"
          },
          "description": {
            "es-MX": "Todo pasó.",
            "en": "Everything passed."
