              "op": "set",
              "field": "commitSha",
              "value": {
                "op": "arg",
                "name": "commitSha"
              }
            },
            {
              "op": "set",
              "field": "timeoutSeconds",
              "value": {
                "op": "arg",
                "name": "timeoutSeconds"
              }
            }
          ],
          "emits": ["CheckRunQueued"]
        },
        {
          "command": "StartCheckRun",
          "from": ["Queued"],
          "to": "Running",
          "guards": [],
          "effects": [],
          "emits": ["CheckRunStarted"]
        },
        {
          "command": "PassCheckRun",
          "from": ["Running"],
          "to": "Passed",
          "guards": ["RunWithinTimeout"],
          "effects": [
            {
              "op": "set",
              "field": "durationSeconds",
              "value": {
                "op": "arg",
                "name": "durationSeconds"
              }
            }
          ],
          "emits": ["CheckRunPassed"]
        },
        {
          "command": "FailCheckRun",
          "from": ["Running"],
          "to": "Failed",
          "guards": [],
          "effects": [
            {
              "op": "set",
