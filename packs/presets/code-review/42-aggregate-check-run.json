            "en": "Within the timeout"
          },
          "description": {
            "es-MX": "Una corrida que se pasa de su tiempo límite no puede quedar en verde.",
            "en": "A run that exceeds its timeout cannot pass."
          },
          "predicate": {
            "kind": "compare",
            "left": {
              "op": "arg",
              "name": "durationSeconds"
            },
            "operator": "<=",
            "right": {
              "op": "field",
              "name": "timeoutSeconds"
            }
          },
          "message": {
            "es-MX": "La corrida se pasó del tiempo límite.",
            "en": "The run exceeded its timeout."
          },
          "violation": {
            "given": [
              {
                "command": "QueueCheckRun",
                "args": {
                  "pullRequestId": "pr_4n8w2c6v",
                  "commitSha": "3f9a2c1",
                  "timeoutSeconds": 600
                }
              },
              {
                "command": "StartCheckRun",
                "args": {}
              }
            ],
            "when": {
              "command": "PassCheckRun",
              "args": {
                "durationSeconds": 1800
              }
            }
          }
        }
      ],
      "invariants": [],
      "transitions": [
