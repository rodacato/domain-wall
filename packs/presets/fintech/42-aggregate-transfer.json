              "value": {
                "op": "arg",
                "name": "payeeAccount"
              }
            },
            {
              "op": "set",
              "field": "payeeAccountKind",
              "value": {
                "op": "arg",
                "name": "payeeAccountKind"
              }
            },
            {
              "op": "set",
              "field": "payeeInstitution",
              "value": {
                "op": "arg",
                "name": "payeeInstitution"
              }
            },
            {
              "op": "set",
              "field": "amount",
              "value": {
                "op": "arg",
                "name": "amount"
              }
            },
            {
              "op": "set",
              "field": "concept",
              "value": {
                "op": "arg",
                "name": "concept"
              }
            },
            {
              "op": "set",
              "field": "requestedOn",
              "value": {
                "op": "arg",
                "name": "requestedOn"
              }
            }
          ],
          "emits": ["TransferRequested"]
        },
        {
          "command": "SubmitTransfer",
          "from": ["Requested"],
          "to": "Submitted",
          "guards": [],
          "effects": [
            {
              "op": "set",
              "field": "trackingKey",
              "value": {
                "op": "arg",
                "name": "trackingKey"
              }
            }
          ],
          "emits": ["TransferSubmitted"]
        },
        {
          "command": "SettleTransfer",
          "from": ["Submitted"],
          "to": "Settled",
          "guards": [],
          "effects": [],
          "emits": ["TransferSettled"]
        },
        {
          "command": "RejectTransfer",
          "from": ["Submitted"],
          "to": "Rejected",
          "guards": [],
          "effects": [
            {
              "op": "set",
              "field": "rejectionReason",
              "value": {
                "op": "arg",
                "name": "reason"
              }
            }
          ],
          "emits": ["TransferRejected"]
        }
      ],
