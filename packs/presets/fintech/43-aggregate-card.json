            "en": "Only people with full verification can request a card."
          },
          "predicate": {
            "kind": "compare",
            "left": {
              "op": "arg",
              "name": "kycLevel"
            },
            "operator": "==",
            "right": {
              "op": "literal",
              "value": "Full"
            }
          },
          "message": {
