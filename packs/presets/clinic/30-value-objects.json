{
  "valueObjects": [
    {
      "kind": "scalar",
      "codeName": "AppointmentId",
      "label": {
        "es-MX": "Cita",
        "en": "Appointment"
      },
      "description": {
        "es-MX": "Identificador de una cita.",
        "en": "Identifier of an appointment."
      },
      "base": "string",
      "constraints": [
        {
          "kind": "pattern",
          "value": "apt_[a-z0-9]{8}",
          "errorCode": "AppointmentIdMalformed",
          "message": {
            "es-MX": "El identificador de una cita debe empezar con apt_ seguido de 8 caracteres.",
            "en": "The identifier of an appointment must start with apt_ followed by 8 characters."
          },
          "invalidExamples": ["APT_12345678", "apt_123"]
        }
      ],
      "examples": {
        "valid": ["apt_4k8m2x7q"]
      }
    },
    {
      "kind": "scalar",
      "codeName": "PatientId",
      "label": {
        "es-MX": "Paciente",
