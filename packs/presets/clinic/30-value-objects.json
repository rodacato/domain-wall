      },
      "description": {
        "es-MX": "Identificador de una factura.",
        "en": "Identifier of an invoice."
      },
      "base": "string",
      "constraints": [
        {
          "kind": "pattern",
          "value": "inv_[a-z0-9]{8}",
          "errorCode": "InvoiceIdMalformed",
          "message": {
            "es-MX": "El identificador de una factura debe empezar con inv_ seguido de 8 caracteres.",
            "en": "The identifier of an invoice must start with inv_ followed by 8 characters."
