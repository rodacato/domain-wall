        "en": "Reference the insurer assigns to the claim: CLM- and eight digits."
      },
      "base": "string",
      "constraints": [
        {
          "kind": "pattern",
          "value": "CLM-[0-9]{8}",
          "errorCode": "ClaimReferenceMalformed",
          "message": {
            "es-MX": "La referencia debe ser CLM- seguida de 8 dígitos.",
            "en": "The reference must be CLM- followed by 8 digits."
          },
          "invalidExamples": ["clm-20260310", "CLM-123", "CLM-ABCDEFGH"]
        }
      ],
      "examples": {
        "valid": ["CLM-20260310"]
      }
    },
    {
      "kind": "scalar",
      "codeName": "TaxId",
      "label": {
        "es-MX": "RFC",
        "en": "Tax ID"
      },
      "description": {
        "es-MX": "Registro Federal de Contribuyentes: 3 o 4 letras, 6 dígitos de fecha y 3 caracteres de homoclave.",
        "en": "Mexican taxpayer ID: 3 or 4 letters, 6 date digits and a 3-character suffix."
      },
      "base": "string",
      "constraints": [
        {
          "kind": "pattern",
          "value": "[A-Z&]{3,4}[0-9]{6}[A-Z0-9]{3}",
          "errorCode": "TaxIdMalformed",
          "message": {
            "es-MX": "El RFC no tiene el formato correcto.",
            "en": "The tax ID does not have the right format."
          },
          "invalidExamples": ["xaxx010101000", "123", "ABC12"]
        }
      ],
      "examples": {
        "valid": ["XAXX010101000", "MAGR880412H67"]
