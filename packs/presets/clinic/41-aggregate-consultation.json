            "kind": "compare",
            "left": {
              "op": "count",
              "collection": {
                "op": "field",
                "name": "observations"
              }
            },
            "operator": "<=",
            "right": {
              "op": "literal",
              "value": 8
            }
          },
          "message": {
            "es-MX": "Una consulta admite como máximo 8 observaciones.",
            "en": "A consultation allows at most 8 observations."
          },
          "violation": {
            "given": [
              {
                "command": "OpenConsultation",
                "args": {}
              },
              {
                "command": "StartConsultation",
                "args": {}
              },
              {
                "command": "RecordObservation",
                "args": {}
