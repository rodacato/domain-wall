      "states": [
        {
          "codeName": "Pending",
          "label": {
            "es-MX": "Pendiente",
            "en": "Pending"
          },
          "description": {
            "es-MX": "La consulta existe pero la persona aún no llega.",
            "en": "The consultation exists but the person has not arrived yet."
          },
          "terminal": false,
          "data": []
        },
        {
          "codeName": "Waiting",
          "label": {
            "es-MX": "En espera",
            "en": "Waiting"
          },
          "description": {
            "es-MX": "El expediente está abierto y la persona espera en la sala.",
            "en": "The file is open and the person waits in the waiting room."
          },
          "terminal": false,
          "data": []
        },
        {
          "codeName": "InProgress",
          "label": {
            "es-MX": "En consulta",
            "en": "In progress"
          },
          "description": {
            "es-MX": "El médico atiende a la persona y registra lo que observa.",
            "en": "The physician is seeing the person and recording what is observed."
          },
          "terminal": false,
          "data": [
