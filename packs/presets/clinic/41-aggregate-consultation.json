                "en": "Follow-up days"
              },
              "type": {
                "kind": "valueObject",
                "ref": "FollowUpDays"
              }
            }
          ]
        }
      ],
      "initialState": "Pending",
      "rules": [
        {
          "codeName": "DiagnosisNeedsObservations",
          "label": {
            "es-MX": "El diagnóstico se apoya en observaciones",
            "en": "A diagnosis rests on observations"
          },
          "description": {
            "es-MX": "No se diagnostica sin haber anotado al menos una observación.",
            "en": "Nobody is diagnosed without at least one recorded observation."
          },
          "predicate": {
            "kind": "notEmpty",
            "value": {
              "op": "field",
              "name": "observations"
            }
          },
          "message": {
            "es-MX": "Registra al menos una observación antes del diagnóstico.",
            "en": "Record at least one observation before the diagnosis."
          },
          "violation": {
            "given": [
              {
                "command": "OpenConsultation",
                "args": {}
              },
              {
                "command": "StartConsultation",
                "args": {}
              }
            ],
            "when": {
              "command": "RecordDiagnosis",
              "args": {}
            }
          }
        },
        {
          "codeName": "DiagnosisRequiredToClose",
          "label": {
            "es-MX": "No se cierra la consulta sin diagnóstico",
            "en": "A consultation cannot close without a diagnosis"
          },
          "description": {
            "es-MX": "Toda consulta termina con un diagnóstico registrado.",
            "en": "Every consultation ends with a recorded diagnosis."
          },
          "predicate": {
            "kind": "present",
            "value": {
              "op": "field",
              "name": "diagnosis"
            }
          },
          "message": {
            "es-MX": "Falta registrar el diagnóstico para cerrar la consulta.",
            "en": "The diagnosis must be recorded to close the consultation."
          },
          "violation": {
            "given": [
              {
                "command": "OpenConsultation",
                "args": {}
              },
              {
                "command": "StartConsultation",
                "args": {}
              },
              {
                "command": "RecordObservation",
                "args": {}
              }
            ],
            "when": {
              "command": "CloseConsultation",
              "args": {}
            }
          }
        },
        {
          "codeName": "FollowUpWithinLimit",
          "label": {
            "es-MX": "El seguimiento no pasa de 90 días",
            "en": "Follow-up cannot exceed 90 days"
          },
          "description": {
            "es-MX": "Más allá de tres meses ya no es seguimiento, es una consulta nueva.",
            "en": "Beyond three months it is no longer follow-up, it is a new consultation."
          },
          "predicate": {
            "kind": "compare",
            "left": {
              "op": "arg",
              "name": "followUpDays"
            },
            "operator": "<=",
            "right": {
              "op": "literal",
              "value": 90
            }
          },
          "message": {
            "es-MX": "El seguimiento puede ser dentro de 90 días como máximo.",
            "en": "Follow-up can be at most 90 days away."
          },
          "violation": {
            "given": [
              {
                "command": "OpenConsultation",
                "args": {}
              },
              {
                "command": "StartConsultation",
                "args": {}
              },
              {
                "command": "RecordObservation",
                "args": {}
              },
              {
                "command": "RecordDiagnosis",
                "args": {}
              }
            ],
            "when": {
              "command": "CloseConsultation",
              "args": {
                "followUpDays": 120
              }
            }
          }
        },
        {
          "codeName": "ObservationsWithinLimit",
          "label": {
            "es-MX": "Una consulta registra hasta 8 observaciones",
            "en": "A consultation records up to 8 observations"
