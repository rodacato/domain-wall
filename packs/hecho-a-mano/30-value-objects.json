{
  "valueObjects": [
    {
      "kind": "scalar",
      "codeName": "OrderId",
      "label": {
        "es-MX": "Pedido",
        "en": "Order"
      },
      "description": {
        "es-MX": "Identificador de un pedido.",
        "en": "Identifier of an order."
      },
      "base": "string",
      "constraints": [
        {
          "kind": "pattern",
          "value": "ord_[a-z0-9]{8}",
          "errorCode": "OrderIdMalformed",
          "message": {
            "es-MX": "El identificador de pedido debe empezar con ord_ seguido de 8 caracteres.",
            "en": "The order identifier must start with ord_ followed by 8 characters."
          },
          "invalidExamples": ["ORD_12345678", "ord_123"]
        }
      ],
      "examples": {
        "valid": ["ord_7k2m9x1q"]
      }
    },
    {
      "kind": "scalar",
      "codeName": "BuyerId",
      "label": {
        "es-MX": "Comprador",
        "en": "Buyer"
      },
      "description": {
        "es-MX": "Identificador de un comprador.",
        "en": "Identifier of a buyer."
