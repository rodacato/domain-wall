            "es-MX": "El identificador de ficha debe empezar con lst_ seguido de 8 caracteres.",
            "en": "The listing identifier must start with lst_ followed by 8 characters."
          },
          "invalidExamples": ["LST_12345678", "lst_123"]
        }
      ],
      "examples": {
        "valid": ["lst_2b6f8j1k"]
      }
    },
    {
      "kind": "scalar",
      "codeName": "ShipmentId",
      "label": {
        "es-MX": "Envío",
