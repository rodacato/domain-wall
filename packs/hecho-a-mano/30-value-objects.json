          "message": {
            "es-MX": "El identificador de artesano debe empezar con art_ seguido de 8 caracteres.",
            "en": "The artisan identifier must start with art_ followed by 8 characters."
          },
          "invalidExamples": ["ART_12345678", "art_123"]
