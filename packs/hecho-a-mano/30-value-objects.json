    {
      "kind": "enum",
      "codeName": "ShippingService",
      "label": {
        "es-MX": "Servicio de envío",
        "en": "Shipping service"
      },
      "description": {
        "es-MX": "Qué tan rápido viaja el bulto.",
        "en": "How fast the parcel travels."
      },
