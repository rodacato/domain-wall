          "message": {
            "es-MX": "El identificador de comprador debe empezar con buy_ seguido de 8 caracteres.",
            "en": "The buyer identifier must start with buy_ followed by 8 characters."
          },
          "invalidExamples": ["BUY_12345678", "buy_123"]
        }
      ],
      "examples": {
        "valid": ["buy_4h8d2n6w"]
      }
    },
    {
